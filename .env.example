# Скопируйте в .env: cp .env.example .env
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_dev_password
POSTGRES_DB=crm
APP_DB_PASSWORD=crm_app_dev_password
# Администратор БД (миграции)
DATABASE_URL=postgres://crm:crm_dev_password@localhost:5432/crm
# Роль приложения (подпадает под RLS)
APP_DATABASE_URL=postgres://crm_app:crm_app_dev_password@localhost:5432/crm
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_password
S3_BUCKET=crm-files
JWT_SECRET=change-me-in-dev-please-use-a-long-random-string
WEB_ORIGIN=http://localhost:5173

# Telegram (необязательно для разработки; нужен для входа через бота и уведомлений)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Публичный HTTPS-адрес Mini App (нужен Telegram для кнопки; localhost не подходит)
MINIAPP_URL=
